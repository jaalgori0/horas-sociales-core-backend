# =============================================================================
# Configuración del despliegue de producción (deploy/docker-compose.yml).
# Copie este archivo a la carpeta padre como `.env` y reemplace cada CAMBIAR.
#
# Generar un valor aleatorio seguro (funciona en cualquier equipo con Docker,
# también en Windows):
#   docker run --rm alpine sh -c "head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'"
# (o, en Linux/macOS:  openssl rand -hex 32)
#
# ⚠ GUARDE UNA COPIA DE SU .env FUERA DEL EQUIPO. Si se pierde DUI_ENCRYPTION_KEY,
#   los DUI cifrados en la base de datos ya no se pueden recuperar.
# ⚠ El .env real NUNCA se sube a Git.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
DB_NAME=horas_sociales
DB_USER=horas_sociales
DB_PASSWORD=CAMBIAR_contrasena_larga_y_aleatoria

# --- Seguridad (obligatorias) -----------------------------------------------
# Firma de los tokens de sesión: mínimo 32 caracteres.
AUTH_SECRET=CAMBIAR_minimo_32_caracteres_aleatorios_xxxxxxxx
# HMAC para buscar DUI sin guardarlos en claro: mínimo 32 caracteres.
DUI_HASH_KEY=CAMBIAR_minimo_32_caracteres_aleatorios_xxxxxxxx
# Cifrado AES-256 de los DUI: exactamente 64 caracteres hexadecimales.
DUI_ENCRYPTION_KEY=CAMBIAR_64_caracteres_hexadecimales_0123456789abcdef0123456789ab

# --- Cuentas -----------------------------------------------------------------
# false (recomendado): nadie puede crear cuentas desde "Registrarse".
# El administrador por defecto (oarias@uca.edu.sv) se crea solo al primer arranque.
AUTH_ALLOW_REGISTER=false

# --- Opcionales --------------------------------------------------------------
# Puerto en el que se abre la aplicación: http://localhost:8080
FRONTEND_PORT=8080
# Si accede desde otro equipo de la red, agregue su URL separada por coma.
CORS_ORIGINS=http://localhost:8080
# Carpeta del repositorio del frontend (nombre por defecto al clonarlo de GitHub).
FRONTEND_DIR=Proyecto-de-horas-sociales-frontend
